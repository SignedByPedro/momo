# Momo — example only. Never commit actual tokens, passwords or secret keys.
# Configure production values in Vercel > Project > Settings > Environment Variables.

# Essential: OpenAI backend (model override optional; fallback also exists in code).
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=replace_with_supported_model_id

# Essential: Supabase public browser/SSR client settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key

# Essential: Supabase backend-only privileged client. NEVER add NEXT_PUBLIC_ to secret keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key

# Recommended in production for full links in invitations and notification emails.
NEXT_PUBLIC_APP_URL=https://your-momo-domain.example

# Optional: Resend notifications. Keep disabled/unset until the sending domain is verified.
RESEND_API_KEY=replace_with_resend_api_key
LEAD_NOTIFICATION_TO=internal-team@example.com
LEAD_NOTIFICATION_FROM=Momo <noreply@verified-domain.example>
SUPPORT_NOTIFICATION_TO=support-team@example.com
SUPPORT_NOTIFICATION_FROM=Momo Support <support@verified-domain.example>
